{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "outDir": "netlify/functions-build",
    "rootDir": "netlify/functions",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmitOnError": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["netlify/functions/**/*"],
  "exclude": ["node_modules", "netlify/functions-build"]
}
